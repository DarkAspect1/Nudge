            android:action="com.nudge.edge.action.OPEN_DND"
            android:targetPackage="com.nudge.edge"
            android:targetClass="com.nudge.edge.service.ShortcutDndActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="shortcut_volume"
        android:enabled="true"
        android:icon="@drawable/ic_launcher_foreground"
        android:shortcutShortLabel="@string/shortcut_volume_short"
        android:shortcutLongLabel="@string/shortcut_volume_long">
